{
  "name": "@booster/paybridge",
  "version": "0.1.0",
  "description": "Unified Paystack, Flutterwave, and Stripe payment workflows with optional Prisma transaction storage.",
  "type": "module",
  "license": "MIT",
  "author": "Aju Joshua Kalu",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "docs:build": "typedoc",
    "format": "echo \"Formatting is handled at the workspace level.\"",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run docs:build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@prisma/client": "^6.15.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.26.0",
    "express": "^4.21.2",
    "nock": "^14.0.5",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
